# gcloud run deploy --source uploads by this list (without it, gcloud falls back to .gitignore,
# which would drop frontend/.env.production). Keep in step with .dockerignore.
.gcloudignore
# Secrets never enter the build context. frontend/.env.production holds only public VITE_* values.
.env
.env.*
!frontend/.env.production
**/.env
*.pem
*-key.json
service-account*.json
client_secret*.json

# host artefacts that would clobber the Linux installs in the image
.git
.venv
**/node_modules
**/__pycache__
.pytest_cache
.ruff_cache
.mypy_cache
backend/app/static
frontend/dist

# local-only data
data/local*.json
eval
.claude
